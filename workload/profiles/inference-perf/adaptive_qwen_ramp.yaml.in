# Qwen saturation ramp -- same pinned shape as adaptive_qwen_codecomp, stepped through rates to
# locate the e2e-latency knee. Starts higher than Gemma's ramp: Qwen's 64-token outputs hold the
# decode batch ~4x less time, so it saturates far later. interval: 30 drains between steps.
load:
  type: poisson
  interval: 30
  request_timeout: 120
  stages:
  - {rate: 20.0, duration: 90}
  - {rate: 25.0, duration: 90}
  - {rate: 30.0, duration: 90}
  - {rate: 35.0, duration: 90}
  - {rate: 40.0, duration: 90}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3.6-35B-A3B-FP8"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3.6-35B-A3B-FP8
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 16,   max: 128,  mean: 64,   std_dev: 32,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: false}
storage:
  local_storage: {path: /workspace}
