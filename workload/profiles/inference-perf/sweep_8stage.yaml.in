# Smart-routed arm. ONE harness through the shared gateway; model_name is a SINGLE
# name -- with NO filter the model-selector takes candidates from IPP listModels
# (both 8B+32B), so the configured scorer + max-score-picker route per request.
# FULL concurrency 50->550->50 (= 2x each pinned arm's half-conc). num_requests per
# stage = 8B-pinned(C/2) + 32B-pinned(C/2) = combined two-pool capacity, so a stage
# runs ~5 min IFF routing uses both pools; longer if it starves one -> stage time
# itself measures routing efficiency.
load:
  type: concurrent
  interval: 30
  request_timeout: 1200
  stages:
  - {concurrency_level: 50,  num_requests: 2200}
  - {concurrency_level: 150, num_requests: 4050}
  - {concurrency_level: 250, num_requests: 4300}
  - {concurrency_level: 350, num_requests: 4350}
  - {concurrency_level: 450, num_requests: 4300}
  - {concurrency_level: 550, num_requests: 4200}
  - {concurrency_level: 450, num_requests: 4300}
  - {concurrency_level: 350, num_requests: 4350}
  - {concurrency_level: 250, num_requests: 4300}
  - {concurrency_level: 150, num_requests: 4050}
  - {concurrency_level: 50,  num_requests: 2200}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3-8B"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3-8B
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: true}
storage:
  local_storage: {path: /workspace}
