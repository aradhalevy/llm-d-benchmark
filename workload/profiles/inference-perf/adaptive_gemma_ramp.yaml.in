# Gemma saturation ramp -- same pinned shape as adaptive_gemma_summarization, stepped through
# rates to locate the e2e-latency knee. interval: 30 drains the queue between steps so a
# saturated step does not spill its backlog into the next one. Read per-stage results from
# stage_<N>_lifecycle_metrics.json.
load:
  type: poisson
  interval: 30
  request_timeout: 120
  stages:
  - {rate: 10.0, duration: 90}
  - {rate: 15.0, duration: 90}
  - {rate: 20.0, duration: 90}
  - {rate: 25.0, duration: 90}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: false}
storage:
  local_storage: {path: /workspace}
