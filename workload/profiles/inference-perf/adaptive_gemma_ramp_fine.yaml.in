# Gemma fine ramp to pin the QUEUE ONSET. The coarse ramp (adaptive_gemma_ramp) showed no queue at
# 10 rps (median TTFT 0.174s) and a deep queue at 15 (9.42s), with delivered throughput plateauing
# at ~11.1 rps under overload -- so the onset is somewhere in 10..12. Step 1 rps at a time.
#
# Read TTFT, not e2e: at 10 rps median e2e is already 9.7s, but that is 256 output tokens of decode
# (~25ms/token), not waiting. TTFT is the wait-before-service and stays ~0.17s until a queue forms.
load:
  type: poisson
  interval: 30
  request_timeout: 120
  stages:
  - {rate: 10.0, duration: 90}
  - {rate: 11.0, duration: 90}
  - {rate: 12.0, duration: 90}
  - {rate: 13.0, duration: 90}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: false}
storage:
  local_storage: {path: /workspace}
