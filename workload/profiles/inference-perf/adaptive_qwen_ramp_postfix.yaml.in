# Qwen ramp ACROSS the old wedge threshold, to validate the --max-num-seqs 64 fix.
#
# Before the fix the engine wedged partway through 30 rps: hybrid GDN+attention forces a 1056-token
# attention block size, prefix caching off, and the recurrent state cannot be preempted, so at
# max_num_seqs=256 the allocator reached a state where nothing could advance and nothing could be
# preempted (num_preemptions_total stayed 0). Capping admission is the guard.
#
# Pass criterion: 30/32/35 rps complete with no failures and generation_tokens_total keeps rising.
# Fail criterion: any stage times out at 120s en masse -- wedged again, cap further (32 -> 16).
# Run with the wedge detector armed; the hang is silent.
load:
  type: poisson
  interval: 30
  request_timeout: 120
  stages:
  - {rate: 26.0, duration: 90}
  - {rate: 30.0, duration: 90}
  - {rate: 32.0, duration: 90}
  - {rate: 35.0, duration: 90}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3.6-35B-A3B-FP8"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3.6-35B-A3B-FP8
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 16,   max: 128,  mean: 64,   std_dev: 32,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: false}
storage:
  local_storage: {path: /workspace}
