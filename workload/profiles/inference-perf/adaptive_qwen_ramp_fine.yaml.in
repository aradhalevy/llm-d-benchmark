# Qwen fine ramp BELOW the wedge threshold. The coarse ramp was clean at 25 rps and wedged the
# engine partway through 30 (see example_outputs/gemma-qwen-adaptive/qwen-engine-wedge/), so step
# in 2-rps increments to find the highest rate that still elevates TTFT without hanging.
# Run alone, on a freshly restarted decode pod, and watch generation_tokens_total for progress --
# the wedge is silent, so "no errors" does not mean it is healthy.
load:
  type: poisson
  interval: 30
  request_timeout: 120
  stages:
  - {rate: 20.0, duration: 90}
  - {rate: 22.0, duration: 90}
  - {rate: 24.0, duration: 90}
  - {rate: 26.0, duration: 90}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3.6-35B-A3B-FP8"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3.6-35B-A3B-FP8
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 16,   max: 128,  mean: 64,   std_dev: 32,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: false}
storage:
  local_storage: {path: /workspace}
