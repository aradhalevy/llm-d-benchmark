# Qwen-PINNED load for the adaptive experiment. Exact model_name -> the IPP
# model-group-name-filter pins every request to the Qwen pool. Code-completion shape (~2048 in /
# short out, random, no prefix reuse) -- distinct from Gemma's summarization so the two pinned
# loads are separable in plots. One 180s poisson @20 rps building block (=one stage);
# adaptive_toggle_run.sh launches it in the stages where Qwen-only is "on" (-1, 3, 4).
load:
  type: poisson
  interval: 0
  request_timeout: 120
  stages:
  # 15 rps against the ~18.9 rps ceiling measured after the --max-num-seqs 64 fix
  # (adaptive_qwen_ramp_postfix) -- ~79% utilisation, deliberately JUST UNDER saturation so the pool
  # keeps headroom for the shared stream. 20 rps was already mildly over (median TTFT 4.57s in
  # stage -1). Above ~30 rps the engine used to wedge outright -- see
  # example_outputs/gemma-qwen-adaptive/qwen-engine-wedge/.
  - {rate: 15.0, duration: 180}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3.6-35B-A3B-FP8"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3.6-35B-A3B-FP8
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 16,   max: 128,  mean: 64,   std_dev: 32,  total_count: 200}
report:
  # per_request embeds every prompt+completion: 0.5-1.2 GB per run (random/shareGPT text escapes
  # to ~6 B/char), which stalls result collection for 20+ min and has OOM'd runs. Splits come
  # from the vLLM counters and distributions from summary/per_stage, so it is not needed here.
  request_lifecycle: {summary: true, per_stage: true, per_request: false}
storage:
  local_storage: {path: /workspace}
