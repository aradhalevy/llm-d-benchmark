# 8B PINNED pyramid baseline for the p25 auto comparison. model="Qwen/Qwen3-8B" -> model-group-name-
# filter pins to the 8B pool ONLY (no offload); everything else (ttft-aware scorer, config) is
# identical to the auto run -> matched e2e. Pyramid 4->16->4 RPS, 11x300s = 3300s.
load:
  type: poisson
  interval: 0
  request_timeout: 1200
  stages:
  - {rate: 4.0,  duration: 300}
  - {rate: 8.0,  duration: 300}
  - {rate: 10.0, duration: 300}
  - {rate: 12.0, duration: 300}
  - {rate: 14.0, duration: 300}
  - {rate: 16.0, duration: 300}
  - {rate: 14.0, duration: 300}
  - {rate: 12.0, duration: 300}
  - {rate: 10.0, duration: 300}
  - {rate: 8.0,  duration: 300}
  - {rate: 4.0,  duration: 300}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3-8B"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3-8B
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: true}
storage:
  local_storage: {path: /workspace}
