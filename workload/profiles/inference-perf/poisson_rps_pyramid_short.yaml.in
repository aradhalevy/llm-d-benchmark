# SHORT probe (20s/stage) variant of poisson_rps_pyramid.yaml.in -- just to eyeball where each
# pool saturates; too short for stable percentiles (saturated-stage requests span boundaries).
load:
  type: poisson
  interval: 0
  request_timeout: 1200
  # Symmetric pyramid: up 16->72 then back down 72->16 (11 stages).
  stages:
  - {rate: 16.0, duration: 20}
  - {rate: 24.0, duration: 20}
  - {rate: 32.0, duration: 20}
  - {rate: 44.0, duration: 20}
  - {rate: 58.0, duration: 20}
  - {rate: 72.0, duration: 20}
  - {rate: 58.0, duration: 20}
  - {rate: 44.0, duration: 20}
  - {rate: 32.0, duration: 20}
  - {rate: 24.0, duration: 20}
  - {rate: 16.0, duration: 20}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3-8B"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3-8B
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: true}
storage:
  local_storage: {path: /workspace}
