# Poisson RPS ladder for multi-cluster EPP routing on GPUs (cicd/ocp-mc-leaf).
#
# The multicluster scorers read only pool-aggregate KV-cache utilization and
# queue depth, so a leaf has to be under real pressure before either moves.
# Nothing throttles the servers here -- the pressure comes from the rate.
#
# Asymmetry does the work: split evenly, a 1+3 layout puts half the fleet's
# rate on a single GPU, so the small leaf reaches its limit long before the
# fleet does. That gap is exactly what the scored arm should close.
#
# Rates target that window. Measured on 4 H100s (Qwen3-8B, 1 GPU/pod): ~12
# req/s per pod, so an even split overloads the 1-replica leaf above ~24 req/s
# while the fleet still has headroom to ~48. Peak 40 sits inside it. An earlier
# ladder peaking at 15 stayed entirely below the window and both arms tied.
#
# The ladder climbs and comes back down so recovery is visible too: a router
# that only sheds load one way shows up on the descent.
load:
  type: poisson
  interval: 0
  stages:
    - {rate: 8,  duration: 300}
    - {rate: 16, duration: 300}
    - {rate: 24, duration: 300}
    - {rate: 32, duration: 300}
    - {rate: 40, duration: 300}
    - {rate: 32, duration: 300}
    - {rate: 24, duration: 300}
    - {rate: 16, duration: 300}
    - {rate: 8,  duration: 300}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: true
storage:
  local_storage:
    path: /workspace
