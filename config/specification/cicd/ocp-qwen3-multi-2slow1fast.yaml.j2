# OpenShift Multi-Model Qwen3 IPP Specification -- asymmetric replicas
# Real vLLM pods on H100 GPUs for IPP scorer/picker evaluation.
# Slow dense Qwen3-32B pool = 2 decode pods, fast MoE Qwen3-30B-A3B pool = 1.
# See scenarios/cicd/ocp-qwen3-multi-2slow1fast.yaml for details.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/ocp-qwen3-multi-2slow1fast.yaml
