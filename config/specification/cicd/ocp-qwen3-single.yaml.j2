# OpenShift Qwen3 IPP -- single-stack RUN spec.
# Standup/teardown with cicd/ocp-qwen3-multi (deploys BOTH pools); use THIS
# spec only for `run`, so a single Qwen3-30B-A3B harness drives load through
# the shared gateway. IPP routes across both pools regardless of the requested
# model, so one harness is the correct, unconfounded load source.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/ocp-qwen3-single.yaml
