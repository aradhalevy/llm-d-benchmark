# OpenShift Multi-Model Qwen3 IPP Specification
# Real vLLM pods on H100 GPUs for IPP scorer/picker evaluation.
# See scenarios/cicd/ocp-qwen3-multi.yaml for details.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
# Scenario lives in this bundle (ipp_benchmarking/); templates/defaults above
# come from the repo root. base_dir is the repo root (cwd by default).
scenario_file:
  path: {{ base_dir }}/ipp_benchmarking/config/scenarios/cicd/ocp-qwen3-multi.yaml
