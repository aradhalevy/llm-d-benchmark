# Kind Simulated Accelerators -- Multi-Model CI/CD Specification
# Two InferencePools (facebook/opt-125m, facebook/opt-350m) on Kind, no GPU.
# HTTPRoutes generated per-pool via experimentalHttpRoute (header-match on
# X-Gateway-Base-Model-Name), requires IPP in the data path.
# See scenarios/cicd/kind-sim-multi.yaml for details.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
# Scenario lives in this bundle (ipp_benchmarking/); templates/defaults above
# come from the repo root. base_dir is the repo root (cwd by default).
scenario_file:
  path: {{ base_dir }}/ipp_benchmarking/config/scenarios/cicd/kind-sim-multi.yaml
