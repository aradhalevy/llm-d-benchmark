# Summarizer workload for the latency-blog benchmark (README section C).
# Prefill-heavy long-in/short-out shape of page summarization. Offers BOTH
# models via the string-encoded array; the IPP model-selector routes.
#
# RATES ARE PLACEHOLDERS until calibration: run this profile pinned to each
# model separately (set model_name to a single name) with an increasing ramp
# to find each pool's saturation knee K_small / K_big at this exact token
# shape, then set:
#   stages 1-2: 0.5 x K_small            (nothing saturated)
#   stages 3-4: ~1.4 x K_small, < K_small + K_big   (small saturated, big absorbs)
#   stages 5-6: ~1.2 x (K_small + K_big) (both saturated)
load:
  type: poisson
  stages:
  - rate: 5          # 0.5 x K_small placeholder
    duration: 120
  - rate: 5
    duration: 120
  - rate: 14         # ~1.4 x K_small placeholder
    duration: 120
  - rate: 14
    duration: 120
  - rate: 24         # ~1.2 x (K_small + K_big) placeholder
    duration: 120
  - rate: 24
    duration: 120
  request_timeout: 90
api:
  type: completion
  streaming: true
server:
  type: vllm
  # "Choose among these": string-encoded JSON array for the model-name-filter.
  # For the pinned baseline (variant B), replace with: "Qwen/Qwen3-8B".
  model_name: '["Qwen/Qwen3-8B","Qwen/Qwen3-32B"]'
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  # Open tokenizer (gemma's HF repo is gated); only affects synthetic token
  # counting, not routing.
  pretrained_model_name_or_path: Qwen/Qwen3-8B
data:
  type: random
  input_distribution:
    min: 1024
    max: 4096
    mean: 2048
    std_dev: 512
    total_count: 200
  output_distribution:
    min: 128
    max: 512
    mean: 256
    std_dev: 64
    total_count: 200
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: true
storage:
  local_storage:
    path: /workspace
