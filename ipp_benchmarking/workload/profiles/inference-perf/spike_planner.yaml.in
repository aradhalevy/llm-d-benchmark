load:
  type: constant
  stages:
  # "Planner" traffic: rare, pinned to a single model by naming it.
  - rate: 0.5
    duration: 300
  request_timeout: 90
api:
  type: completion
  streaming: true
server:
  type: vllm
  # Single model name: the model-name-filter pins these requests to it.
  model_name: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: facebook/opt-125m
data:
  type: random
  input_distribution:
    min: 256
    max: 512
    mean: 384
    std_dev: 10
    total_count: 100
  output_distribution:
    min: 40
    max: 60
    mean: 50
    std_dev: 5
    total_count: 100
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: true
storage:
  local_storage:
    path: /workspace
