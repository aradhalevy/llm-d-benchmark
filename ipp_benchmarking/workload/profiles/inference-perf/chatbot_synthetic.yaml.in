# Planner workload for the latency-blog benchmark (README section C).
# Rare, long-context plan/synthesis requests pinned to the big model by
# naming it (run with: -m Qwen/Qwen3-32B). Runs from a SECOND
# namespace in run-only mode, concurrently with summarization_synthetic
# (see "Parallel two-harness runs"). Duration covers the summarizer's
# 6 x 120s stages plus buffer. Besides simulating the planner, this trickle
# keeps the big model's TTFT EMA fresh in the IPP datalayer.
load:
  type: constant
  stages:
  - rate: 0.3
    duration: 800
  request_timeout: 120
api:
  type: completion
  streaming: true
server:
  type: vllm
  # Pinned: a single model name; the model-name-filter routes only here.
  model_name: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  # Open tokenizer (gemma's HF repo is gated); approximation is fine for
  # synthetic data.
  pretrained_model_name_or_path: Qwen/Qwen3-8B
data:
  type: random
  # Long-context plan/synthesis shape. Keep input + output under the pods'
  # --max-model-len (8192).
  input_distribution:
    min: 2048
    max: 6144
    mean: 4096
    std_dev: 1024
    total_count: 100
  output_distribution:
    min: 512
    max: 1536
    mean: 1024
    std_dev: 256
    total_count: 100
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: true
storage:
  local_storage:
    path: /workspace
