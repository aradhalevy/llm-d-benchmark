load:
  type: poisson
  stages:
  # Stages 1-2: nothing saturated (fast model alone handles ~2.9 rps)
  - rate: 1.5
    duration: 60
  - rate: 1.5
    duration: 60
  # Stages 3-4: fast model saturated, combined capacity (~3.6 rps) not exceeded
  - rate: 3.2
    duration: 60
  - rate: 3.2
    duration: 60
  # Stages 5-6: both models saturated
  - rate: 5
    duration: 60
  - rate: 5
    duration: 60
  request_timeout: 90
api:
  type: completion
  streaming: true
server:
  type: vllm
  # String-encoded JSON array: "choose among these" for the model-name-filter.
  model_name: '["facebook/opt-125m","facebook/opt-350m"]'
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: facebook/opt-125m
data:
  type: random
  input_distribution:
    min: 256
    max: 512
    mean: 384
    std_dev: 10
    total_count: 100
  output_distribution:
    min: 40
    max: 60
    mean: 50
    std_dev: 5
    total_count: 100
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: true
storage:
  local_storage:
    path: /workspace
