# Concurrency sweep 30..230 (+20/stage) — pushes past the FAST sim's capacity too,
# so both pools saturate and the system-wide ceiling is visible. num_requests=4*concurrency.
load:
  type: concurrent
  interval: 15
  request_timeout: 90
  stages:
  - {concurrency_level: 30,  num_requests: 120}
  - {concurrency_level: 50,  num_requests: 200}
  - {concurrency_level: 70,  num_requests: 280}
  - {concurrency_level: 90,  num_requests: 360}
  - {concurrency_level: 110, num_requests: 440}
  - {concurrency_level: 130, num_requests: 520}
  - {concurrency_level: 150, num_requests: 600}
  - {concurrency_level: 170, num_requests: 680}
  - {concurrency_level: 190, num_requests: 760}
  - {concurrency_level: 210, num_requests: 840}
  - {concurrency_level: 230, num_requests: 920}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: '["facebook/opt-125m","facebook/opt-350m"]'
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: facebook/opt-125m
data:
  type: random
  input_distribution: {min: 256, max: 512, mean: 384, std_dev: 10, total_count: 100}
  output_distribution: {min: 40, max: 60, mean: 50, std_dev: 5, total_count: 100}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: true}
storage:
  local_storage: {path: /workspace}
