# A/B routing sweep, NO timeouts (HTTPRoute lifted to 1200s). 6 concurrency stages
# 50->550 (+100), ~10 min each: num_requests=1500 sized off the measured uncapped
# saturation rate ~2.5 req/s (1500/2.5 ~= 600s). Closed-loop keeps exactly C in
# flight so latency stabilizes per stage (no runaway). interval=15s -> idle gap
# between stages for clean idle-gap clustering by the plotters. Same 2048-in/256-out
# summarizer shape + model-array as the prior runs (IPP chooses among 8B/32B).
# Post-run: trim first/last 10% of each stage (ramp/drain + cold-EMA) before stats.
load:
  type: concurrent
  interval: 15
  request_timeout: 1200
  stages:
  - {concurrency_level: 50,  num_requests: 1500}
  - {concurrency_level: 150, num_requests: 1500}
  - {concurrency_level: 250, num_requests: 1500}
  - {concurrency_level: 350, num_requests: 1500}
  - {concurrency_level: 450, num_requests: 1500}
  - {concurrency_level: 550, num_requests: 1500}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: '["Qwen/Qwen3-8B","Qwen/Qwen3-32B"]'
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: Qwen/Qwen3-8B
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: true}
storage:
  local_storage: {path: /workspace}
