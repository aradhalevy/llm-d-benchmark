load:
  type: constant
  stages:
  - rate: 5
    duration: 20
  request_timeout: 200
api:
  type: completion
  streaming: true
server:
  type: vllm
  # String-encoded JSON array: tests whether the model-name-filter accepts a
  # string whose content is a JSON array of candidate model names.
  model_name: '["facebook/opt-125m","facebook/opt-350m"]'
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: facebook/opt-125m
data:
  type: random
  input_distribution:
    min: 256
    max: 512
    mean: 384
    std_dev: 10
    total_count: 100
  output_distribution:
    min: 10
    max: 100
    mean: 50
    std_dev: 10
    total_count: 100
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: true
storage:
  local_storage:
    path: /workspace
